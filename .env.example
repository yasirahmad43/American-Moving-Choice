# American Moving Choice: environment variables (build plan §10). Copy to .env.local in apps/web
# and apps/app (or export them) for local runs. Never commit real values.

# --- Database (both apps) -------------------------------------------------------------------
# Local Postgres 16, as the non-superuser owner role amc_app (pnpm db:reset creates it), so
# row-level security applies locally exactly as on Supabase. In the cloud: the Supabase pooler URL
# for the amc_app role.
DATABASE_URL=postgres://amc_app:amc_app@localhost:5432/amc_dev
# pnpm db:reset only: a superuser connection that creates the owner role and the database.
DATABASE_ADMIN_URL=postgres://amc:amc@localhost:5432/postgres
# disable (local only; production refuses it for a remote host) | require (encrypted, certificate
# not verified) | verify (encrypted and verified; use this in the cloud with DATABASE_SSL_CA)
DATABASE_SSL=disable
# PEM of the database's CA certificate for DATABASE_SSL=verify (Supabase: project settings, SSL
# configuration). Literal \n sequences are turned into newlines.
DATABASE_SSL_CA=
# Connections per server instance (serverless instances multiply this). Default 3.
DATABASE_POOL_MAX=3

# --- Secrets (required in production) -----------------------------------------------------------
# Both apps. 32+ characters: openssl rand -base64 48
# Keys the HMACs that keep emails and IP addresses out of rate-limit keys, and the email and phone
# hashes used for duplicate grouping (the seed build needs the same value). Rotating it breaks
# duplicate grouping with earlier requests.
HMAC_SECRET=
# App only. 32+ characters.
SESSION_SECRET=
# 32 bytes as 64 hex characters or base64: openssl rand -hex 32
# Encrypts TOTP secrets (AES-256-GCM). Changing it invalidates every enrolled authenticator.
APP_ENCRYPTION_KEY=
# Protects /api/cron/* (app only).
CRON_SECRET=

# --- URLs (both apps) ---------------------------------------------------------------------------
WEB_URL=http://localhost:3000
APP_URL=http://localhost:3001

# --- Preview switches ---------------------------------------------------------------------------
DEMO_MODE=true
# App only. Owner-requested password-only admin sign-in in demos; ignored if DEMO_MODE=false.
DEMO_ADMIN_PASSWORD_ONLY=false
# Web only. false keeps noindex on every page and robots.txt disallowing everything.
SITE_INDEXABLE=false

# --- Optional integrations: leave empty for demo modes (build plan §9) --------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
# Sender used when Postmark is configured.
EMAIL_FROM=American Moving Choice <notifications@americanmovingchoice.invalid>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FMCSA_WEBKEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Claude content pilot (server/offline worker only; never NEXT_PUBLIC_) ------------------
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# This first pilot's cumulative maximum. The worker also enforces its durable reservation ledger.
AI_CONTENT_BUDGET_USD=50
# Automatic generation stays disabled; offline paid commands require an explicit invocation.
AI_CONTENT_ENABLED=false

# --- Demo seed (pnpm db:seed:build only) ---------------------------------------------------------
# Passwords 12-72 bytes, generated (openssl rand -base64 24), never written in the repository.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MOVER_EMAIL=
SEED_MOVER_PASSWORD=
# Base32 TOTP secret enrolled for the seeded admin (required for a deployable seed; needs
# APP_ENCRYPTION_KEY and HMAC_SECRET above set to the app's values). Generate one with:
#   node -e "console.log(require('otpauth').Secret.fromHex(require('crypto').randomBytes(20).toString('hex')).base32)"
# (run inside packages/server), and add it to the owner's authenticator app.
SEED_ADMIN_TOTP_SECRET=

# --- Durable admin media uploads (app server only; no filesystem fallback) -------------------
SUPABASE_URL=
# Server-only secret credential (preferred); never NEXT_PUBLIC_ or committed to Git.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback; leave empty when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=amc-media
# Optional production-build write/public-read/cleanup proof. Requires the server key above.
AMC_VERIFY_MEDIA_STORAGE=false
