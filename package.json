{
  "name": "american-moving-choice",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @amc/web dev",
    "dev:app": "pnpm --filter @amc/app dev",
    "build": "pnpm --filter @amc/web build && pnpm --filter @amc/app build",
    "build:web": "pnpm --filter @amc/web build",
    "build:app": "pnpm --filter @amc/app build",
    "start:web": "pnpm --filter @amc/web start",
    "start:app": "pnpm --filter @amc/app start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @amc/db test",
    "test:server": "pnpm --filter @amc/server test",
    "test:content": "pnpm --filter @amc/server exec vitest run --root ../../apps/web --globals lib/content lib/assistant-faq lib/analytics lib/security lib/attribution.test.mjs lib/search-verification.test.mjs lib/public-form-actions.test.mjs lib/country-proxy.test.mjs lib/page-media-plan.test.mjs lib/public-copy.test.mjs lib/sitemaps.test.mjs components/seo components/survey components/site/adaptive-react-tables.test.mjs",
    "geo:build": "pnpm --filter @amc/server build:zip-data",
    "e2e": "pnpm --filter @amc/e2e e2e",
    "db:migrate": "pnpm --filter @amc/db migrate",
    "db:reset": "pnpm --filter @amc/db reset",
    "db:seed:build": "pnpm --filter @amc/db seed:build",
    "db:bundle:supabase": "pnpm --filter @amc/db bundle:supabase",
    "seo:import-geo": "pnpm --filter @amc/server seo import-geo",
    "seo:import-research": "pnpm --filter @amc/server seo import-research",
    "seo:generate": "pnpm --filter @amc/server seo generate",
    "seo:publish": "pnpm --filter @amc/server seo publish",
    "seo:review": "pnpm --filter @amc/server seo review",
    "seo:report": "pnpm --filter @amc/server seo report",
    "seo:crawl": "pnpm --filter @amc/server exec tsx ../../tools/seo-crawl.ts",
    "media:check": "pnpm --filter @amc/web media:check",
    "seo:media-sync": "pnpm --filter @amc/server seo media-sync"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
