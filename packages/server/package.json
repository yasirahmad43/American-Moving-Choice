    "seo": "tsx scripts/seo.ts"
  },
  "dependencies": {
    "@amc/core": "workspace:*",
    "bcryptjs": "3.0.3",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": "16.4.3",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@amc/db": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zipcodes-us": "1.2.0"
  }
