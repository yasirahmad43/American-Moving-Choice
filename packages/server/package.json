{
  "name": "@amc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-only code: env, database access, auth, audit, settings, outbox, geo, verification and the slice services.",
  "exports": {
    "./*": "./src/*/index.ts"
  },
