{
  "$schema": "./manifest.schema.json",
  "version": 1,
  "notes": [
    "Every image and video on the public site comes from this manifest (apps/web/lib/media.ts).",
    "An asset id may be used on exactly one page (usedOn has one entry); the loader throws in development if a page asks for an asset another page owns.",
    "Entries marked placeholder: true are generated abstract art under /media/placeholders/. Replace src, poster, width, height, alt and credit with the licensed asset; no code change is needed.",
    "Photography rules: documentary, no staged stock, no landmarks that imply endorsement, releases on file; generated imagery only for abstract art (docs/design/visual-direction.md section 10)."
  ],
  "assets": [
    {
      "id": "home-hero-ambient",
      "kind": "video",
      "src": "/media/placeholders/home-ambient.mp4",
      "sources": [{ "src": "/media/placeholders/home-ambient.mp4", "type": "video/mp4" }],
      "poster": "/media/placeholders/home-hero.svg",
      "width": 1280,
      "height": 720,
      "alt": "",
      "autoplay": true,
      "credit": { "creator": "American Moving Choice design", "source_url": "", "license": "Proprietary", "attribution_required": false },
      "tags": ["hero", "ambient", "navy"],
      "usedOn": ["/"],
      "placeholder": true
    },
    {
      "id": "home-costs-card",
      "kind": "image",
