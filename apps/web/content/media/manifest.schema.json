{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "American Moving Choice media manifest",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "const": 1 },
    "notes": { "type": "array", "items": { "type": "string" } },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "src", "width", "height", "alt", "credit", "tags", "usedOn"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "enum": ["image", "video"] },
          "src": { "type": "string", "description": "Site-relative path under /public or an absolute URL." },
          "sources": {
            "type": "array",
            "description": "Video only: alternative encodings in preference order.",
            "items": { "type": "object", "required": ["src", "type"], "properties": { "src": { "type": "string" }, "type": { "type": "string" } } }
          },
          "poster": { "type": "string", "description": "Video only: poster image at the same aspect ratio." },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "alt": { "type": "string", "description": "Empty for decorative media." },
          "autoplay": { "type": "boolean", "description": "Video only: ambient loop, muted, plays only in view and never under prefers-reduced-motion." },
          "credit": {
            "type": "object",
            "required": ["creator", "source_url", "license", "attribution_required"],
            "properties": {
              "creator": { "type": "string" },
              "source_url": { "type": "string" },
              "license": { "type": "string" },
              "attribution_required": { "type": "boolean" }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "usedOn": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" }, "description": "Exactly one page route (pattern form for dynamic routes, e.g. /companies/[slug]/)." },
          "placeholder": { "type": "boolean" },
          "generated": { "type": "boolean" }
        }
      }
    }
  }
}
